# Copie para .env.local e preencha com os dados do seu projeto no Supabase
# (Painel do Supabase > Project Settings > API Keys).
# A chave pública (publishable) pode ir para o navegador: quem protege os dados é o RLS.
# NUNCA coloque aqui a chave secreta (service_role / secret).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
